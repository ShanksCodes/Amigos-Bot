# ============================================================
# Discord Bot Configuration
# ============================================================
# Bot application token from Discord Developer Portal
DISCORD_TOKEN="your_discord_bot_token_here"

# Application / Client ID from Discord Developer Portal
CLIENT_ID="your_client_id_here"

# Optional: Guild ID for instant development slash command deployment
GUILD_ID="your_development_guild_id_here"

# ============================================================
# Database Configuration (PostgreSQL)
# ============================================================
# Local machine connection string (PostgreSQL exposed on host port 5434)
DATABASE_URL="your database connection string"

# Inside Docker Compose network (compose.yml overrides this to the postgres service hostname):

# ============================================================
# Environment & Logging
# ============================================================
NODE_ENV="development"

# Logging level: 'error', 'warn', 'info', 'debug' (defaults to 'debug' in dev, 'info' in prod)
LOG_LEVEL="debug"
