generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      UserProfile?
  guildMembers GuildMember[]
  duelProfile  DuelProfile?
  duelsChallenged DuelHistory[] @relation("DuelChallenger")
  duelsDefended   DuelHistory[] @relation("DuelOpponent")
  duelsWon        DuelHistory[] @relation("DuelWinner")

  guildBirthdaySettings GuildBirthdaySetting[]
  notes                 UserNote[]
}

model UserProfile {
  id         String   @id @default(uuid())
  userId     String   @unique
  timezone   String?
  country    String?
  birthDay   Int?
  birthMonth Int?
  birthYear  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([birthMonth, birthDay])
}

model Guild {
  id        String   @id
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members GuildMember[]
  birthdaySettings GuildBirthdaySetting[]
}

model GuildMember {
  id        String    @id @default(uuid())
  guildId   String
  userId    String
  joinedAt  DateTime?
  leftAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId])
  @@index([guildId])
}

model DuelProfile {
  userId           String @id
  matchesPlayed    Int    @default(0)
  wins             Int    @default(0)
  losses           Int    @default(0)
  currentWinStreak Int    @default(0)
  bestWinStreak    Int    @default(0)
  totalDamageDealt Int    @default(0)
  totalDamageTaken Int    @default(0)
  totalHealing     Int    @default(0)
  criticalHits     Int    @default(0)
  parries          Int    @default(0)
  fastestReaction  Int?   
  totalBerries     Int    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DuelHistory {
  id             String   @id @default(uuid())
  challengerId   String
  opponentId     String
  winnerId       String?  
  mode           String   @default("Regular")
  startedAt      DateTime @default(now())
  endedAt        DateTime
  berriesAwarded Int      @default(0)

  challenger     User     @relation("DuelChallenger", fields: [challengerId], references: [id])
  opponent       User     @relation("DuelOpponent", fields: [opponentId], references: [id])
  winner         User?    @relation("DuelWinner", fields: [winnerId], references: [id])
}

model GuildBirthdaySetting {
  id String @id @default(uuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  guildId String
  guild   Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, guildId])
  @@index([guildId])
}

model BirthdayChange {
  id        String   @id @default(uuid())
  userId    String
  
  prevDay   Int?
  prevMonth Int?
  prevYear  Int?
  
  newDay    Int?
  newMonth  Int?
  newYear   Int?
  
  changedAt DateTime @default(now())

  @@index([userId, changedAt])
}

model BirthdayAnnouncement {
  id           String   @id @default(uuid())
  userId       String
  guildId      String
  birthdayDate DateTime @db.Date
  announcedAt  DateTime @default(now())

  @@unique([userId, guildId, birthdayDate])
}

model GuildBirthdayConfig {
  guildId               String   @id
  announcementChannelId String?
  enabled               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model UserNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}